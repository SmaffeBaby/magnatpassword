{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Magnat",
  "version": "0.2.1",
  "identifier": "ru.magnat.password",
  "build": {
    "frontendDist": "https://192.168.10.250/?native=1",
    "devUrl": "http://localhost:3004",
    "beforeDevCommand": "npm run native:dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Magnat",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 600,
        "url": "https://192.168.10.250/?native=1",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:3003; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:3003; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "default",
        {
          "identifier": "native-actions",
          "windows": [
            "main"
          ],
          "remote": {
            "urls": [
              "https://192.168.10.250/*",
              "http://localhost:3004/*"
            ]
          },
          "permissions": [
            "allow-open-external",
            "allow-save-download",
            "allow-notification-permission",
            "allow-set-unread-count",
            "allow-show-unread-notification"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Magnat — рабочее пространство"
  }
}
