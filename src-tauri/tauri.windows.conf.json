{
  "build": {
    "windows": {
      "staticVCRuntime": true
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
