NUXT_SUPABASE_URL=http://localhost:8003
NUXT_SUPABASE_SERVICE_ROLE_KEY=
NUXT_PUBLIC_SUPABASE_URL=/supabase
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Shells load the hosted Nuxt website. Use a permanent origin reachable by all devices.
# Optional Apple team ID for signing development iPhone builds.
MAGNAT_IOS_TEAM=
MAGNAT_SERVER_URL=http://192.168.10.162:3003
# Optional external build directory. Link .output-native to its .output-native folder.
# MAGNAT_NATIVE_BUILD_ROOT=/Volumes/KINGSTON/Developer/MagnatPassword/frontend
# MAGNAT_ANDROID_STORAGE_ROOT=/Volumes/KINGSTON/Developer/Android
# MAGNAT_ANDROID_JAVA_HOME=/Volumes/KINGSTON/Developer/Android/jdk21/Contents/Home
# MAGNAT_WEB_BUILD_ROOT=/Volumes/KINGSTON/Developer/MagnatPassword/web

# Dedicated base64-encoded 32-byte key for shared vaults at rest.
NUXT_SHARED_VAULT_KEY=

# External SSD directory, mounted into the server container as /releases.
NUXT_RELEASES_DIRECTORY=/releases
# Same secret as RELEASES_BUILD_TOKEN in GitHub Actions.
NUXT_RELEASES_BUILD_TOKEN=
# Host path for docker-compose release volume (must exist on the connected SSD).
MAGNAT_RELEASES_DIR=/Volumes/KINGSTON/Developer/MagnatPassword/releases
